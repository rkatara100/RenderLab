{
  "name": "@renderlab/shared-types",
  "version": "0.1.0",
  "description": "Shared TypeScript contracts between the RenderLab SDK, API, and dashboard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkatara100/RenderLab.git",
    "directory": "packages/shared-types"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^4.1.11"
  }
}
