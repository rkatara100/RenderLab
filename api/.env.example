PORT=8787
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
CORS_ORIGINS=https://your-dashboard.vercel.app
LOG_LEVEL=info
SIGNUP_RATE_LIMIT_MAX=10
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=900
INGEST_RATE_LIMIT_MAX=600
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
READ_RATE_LIMIT_MAX=120
READ_RATE_LIMIT_WINDOW_SECONDS=60
REPLAY_EVENT_CAP=2000
REPLAY_RATE_LIMIT_MAX=30
REPLAY_RATE_LIMIT_WINDOW_SECONDS=60
RETENTION_DAYS=7
SHUTDOWN_GRACE_MS=15000
